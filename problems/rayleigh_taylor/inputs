# Rayleigh-Taylor instability — Liska & Wendroff (2003), section 4.6.
# Domain [0, 1/6] x [0, 1], gamma=5/3, gravity g=0.1 downward (-y).
# Interface y = 1/2 + 0.01*cos(6*pi*x), fluids at rest, hydrostatic pressure.
# Reflecting (wall) BCs on all four borders. Grid 100x400, compare at T=8.5.

physics    = euler
device     = gpu

nx         = 100
ny         = 400

xmin       = 0.0
xmax       = 0.16667
ymin       = 0.0
ymax       = 1.0

steps      = 45200
save_every = 3013

cfl        = 0.3
gamma      = 1.6667
gravity    = 0.1
muscl      = true

ic         = rt

# Liska 4.6: reflecting (wall) on all four borders
bc_left   = wall
bc_right  = wall
bc_bottom = wall
bc_top    = wall
